@model List<UserManagment.Models.User>

<h1>Users</h1>

@if (TempData["Message"] != null)
{
    <p>@TempData["Message"]</p>
}
@if (TempData["Error"] != null)
{
    <p>@TempData["Error"]</p>
}
                    
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>
                    <a href="/Users/Details/@user.Id">View Details</a>
                </td>
                <td>
                    <a href="/Users/Edit/@user.Id">Edit</a>
                </td>
                <td>
                    <form method="post" action="/Users/Delete/@user.Id">
                        <button type="submit">Delete</button>
                    </form>
                </td>
                     
            </tr>
        }
    </tbody>
</table>